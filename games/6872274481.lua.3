run(function()
	local AutoCounter
	local Mode
	local Range
	local Limit
	local PlaceDelay
	local Predict
	local Sides
	local Falling
	local AutoSwitch = {}
	
	local function getAttackData()
	    if Limit.Enabled then
	        local tool = store.hand.tool
	        return tool and tool.Name == 'tnt' and tool or nil
	    end
	    local item = getItem('tnt')
	    return item and item.tool or nil
	end
	
	AutoCounter = larp.Categories.Utility:CreateModule({
	    Name = 'AutoCounter',
	    Function = function(callback)
	        if callback then
	            local tnts, placed = {}, {}
	            AutoCounter:Clean(workspace.ChildAdded:Connect(function(v)
	                if v.Name == 'tnt' then
	                    table.insert(tnts, v)
	                    v.Destroying:Once(function()
	                        local index = table.find(tnts, v)
	                        if index then
	                            table.remove(tnts, index)
	                        end
	                    end)
	                end
	            end))
	            repeat
	                for pos, expiry in placed do
	                    if expiry <= tick() then
	                        placed[pos] = nil
	                    end
	                end
	                if entitylib.isAlive then
	                    local item = getAttackData()
	                    if item then
	                        local localPosition = entitylib.character.RootPart.Position
	                        for _, v in tnts do
	                            local roundedPos = Vector3.new(math.round(v.Position.X), math.round(v.Position.Y), math.round(v.Position.Z))
	                            if (v.Velocity.Y >= 0 or Falling.Enabled) and not placed[roundedPos] and (localPosition - v.Position).Magnitude <= Range.Value then
	                                if not Limit.Enabled and AutoSwitch.Enabled then
	                                    local hotbar = getHotbar(item)
	                                    switchItem(item)
	                                    if hotbar then
	                                        hotbarSwitch(hotbar)
	                                    end
	                                end
	                                placed[roundedPos] = tick() + 3
	                                task.spawn(bedwars.placeBlock, v.Position, item.Name)
	                                if Predict.Enabled then
	                                    local predicted = v.Position + (v.Velocity * 0.2)
	                                    task.spawn(bedwars.placeBlock, predicted, item.Name)
	                                end
	                                if Sides.Enabled then
	                                    for _, offset in {Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0), Vector3.new(0, 0, 3), Vector3.new(0, 0, -3)} do
	                                        task.spawn(bedwars.placeBlock, v.Position + offset, item.Name)
	                                    end
	                                end
	                                task.wait(PlaceDelay.Value)
	                            end
	                        end
	                    end
	                end
	                task.wait(0.1)
	            until not AutoCounter.Enabled
	        end
	    end,
	    Tooltip = 'Automatically places tnt on opponent\'s tnt'
	})
	
	Mode = AutoCounter:CreateDropdown({
	    Name = 'Mode',
	    List = {'Toggle', 'On key'},
	    Default = 'Toggle'
	})
	Range = AutoCounter:CreateSlider({
	    Name = 'Range',
	    Min = 1,
	    Max = 60,
	    Default = 30
	})
	PlaceDelay = AutoCounter:CreateSlider({
	    Name = 'Place Delay',
	    Min = 0.05,
	    Max = 0.5,
	    Decimal = 100,
	    Default = 0.12,
	    Suffix = 'seconds'
	})
	Predict = AutoCounter:CreateToggle({
	    Name = 'Predict',
	    Default = true,
	    Tooltip = 'Also places a block ahead of the tnt\'s movement'
	})
	Sides = AutoCounter:CreateToggle({
	    Name = 'Sides',
	    Tooltip = 'Also places blocks around the tnt to guarantee the catch'
	})
	Falling = AutoCounter:CreateToggle({
	    Name = 'Falling TNT',
	    Tooltip = 'Also counters tnt that is already falling'
	})
	Limit = AutoCounter:CreateToggle({
	    Name = 'Limit to item',
	    Function = function(callback)
	        if AutoSwitch.Object then
	            AutoSwitch.Object.Visible = not callback
	        end
	    end
	})
	AutoSwitch = AutoCounter:CreateToggle({
	    Name = 'Auto Switch',
	    Function = function(callback)
	        Limit.Object.Visible = not callback
	    end,
	    Default = true
	})
end)

run(function()
	local AutoHonor
	local Delay
	
	local Honored = {}
	local function honor()
	    if #Honored > 1 then return end
	    local list, team = table.clone(entitylib.List), lplr:GetAttribute('Team')
	    table.sort(list, function(a, b)
	        return a.Player:GetAttribute('Team') == team and b.Player:GetAttribute('Team') ~= team
	    end)
	    for _, v in list do
	        if #Honored > 1 then break end
	        if not table.find(Honored, v.Player) then
	            bedwars.HonorController:honorPlayer(v.Player.UserId)
	            table.insert(Honored, v.Player)
	            task.wait(Delay.Value)
	        end
	    end
	end
	
	AutoHonor = larp.Categories.Utility:CreateModule({
	    Name = 'AutoHonor',
	    Function = function(callback)
	        if callback then
	            AutoHonor:Clean(larpEvents.EntityDeathEvent.Event:Connect(function(deathTable)
	                if deathTable.finalKill and deathTable.entityInstance == lplr.Character and #bedwars.Store:getState().Party.members <= 0 and store.matchState ~= 2 then
	                    honor()
	                end
	            end))
	            AutoHonor:Clean(larpEvents.MatchEndEvent.Event:Connect(honor))
	        end
	    end,
	    Tooltip = 'Automatically honor your teammates'
	})
	
	Delay = AutoHonor:CreateSlider({
	    Name = 'Delay',
	    Min = 0,
	    Max = 2,
	    Decimal = 100,
	    Suffix = 'seconds',
	    Default = 0.1
	})
end)

