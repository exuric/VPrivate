		Function = function(hue, sat, val)
			if not infolabel then return end
			infolabel.TextColor3 = Color3.fromHSV(hue, sat, val)
			if infoshadow then
				infoshadow.TextColor3 = Color3.fromHSV((hue + 0.5) % 1, sat, math.max(val - 0.8, 0))
